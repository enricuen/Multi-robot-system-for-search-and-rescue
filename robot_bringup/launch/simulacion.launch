<?xml version="1.0"?>
<launch>
    <let name="pkg_descripcion" value="$(find-pkg-share robot_descripcion)" />
    <let name="pkg_bringup" value="$(find-pkg-share robot_bringup)" />
    
    <let name="world_path" value="$(var pkg_bringup)/world/mundo.sdf" />
    <let name="rviz_config_path" value="$(var pkg_descripcion)/rviz/urdf_config.rviz" />

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" 
               value="$(command 'xacro $(var pkg_descripcion)/urdf/robot.urdf.xacro')" />
        <param name="use_sim_time" value="true" />
    </node>

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="-r -v 4 $(var world_path)" /> 
    </include>

    <node pkg="ros_gz_sim" exec="create" 
          args="-name mi_robot -topic robot_description" />

    <node pkg="ros_gz_bridge" exec="parameter_bridge">
        <param name="config_file" value="$(var pkg_bringup)/config/bridge_params.yaml" />
    </node>

    <node pkg="rviz2" exec="rviz2" args="-d $(var rviz_config_path)">
        <param name="use_sim_time" value="true" />
    </node>
</launch>
