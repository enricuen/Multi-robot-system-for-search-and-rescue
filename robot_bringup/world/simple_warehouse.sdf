<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="simple_warehouse">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_1"><static>true</static><pose>0 10 1 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>20 0.5 2</size></box></geometry></visual><collision name="c"><geometry><box><size>20 0.5 2</size></box></geometry></collision></link></model>
    <model name="wall_2"><static>true</static><pose>0 -10 1 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>20 0.5 2</size></box></geometry></visual><collision name="c"><geometry><box><size>20 0.5 2</size></box></geometry></collision></link></model>
    <model name="wall_3"><static>true</static><pose>10 0 1 0 0 1.57</pose><link name="link"><visual name="v"><geometry><box><size>20 0.5 2</size></box></geometry></visual><collision name="c"><geometry><box><size>20 0.5 2</size></box></geometry></collision></link></model>
    <model name="wall_4"><static>true</static><pose>-10 0 1 0 0 1.57</pose><link name="link"><visual name="v"><geometry><box><size>20 0.5 2</size></box></geometry></visual><collision name="c"><geometry><box><size>20 0.5 2</size></box></geometry></collision></link></model>

    <model name="rack_1"><static>true</static><pose>2 3 1.5 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>6 1.5 3</size></box></geometry><material><ambient>0.3 0.2 0.1 1</ambient></material></visual><collision name="c"><geometry><box><size>6 1.5 3</size></box></geometry></collision></link></model>
    <model name="rack_2"><static>true</static><pose>2 -3 1.5 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>6 1.5 3</size></box></geometry><material><ambient>0.3 0.2 0.1 1</ambient></material></visual><collision name="c"><geometry><box><size>6 1.5 3</size></box></geometry></collision></link></model>

    <model name="red_cylinder">
      <static>true</static>
      <pose>7 0 0.5 0 0 0</pose> <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material> </visual>
      </link>
    </model>

  </world>
</sdf>
