<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="prefix" default="" />

    <joint name="$(arg prefix)camera_joint" type="fixed">
        <parent link="$(arg prefix)base_link"/>
        <child link="$(arg prefix)camera_link"/>
        <origin xyz="0.305 0 0.08" rpy="0 0 0"/>
    </joint>

    <link name="$(arg prefix)camera_link">
        <visual>
            <geometry> <box size="0.010 0.03 0.03"/> </geometry>
            <material name="black"/>
        </visual>
    </link>

    <gazebo reference="$(arg prefix)camera_link">
        <sensor type="camera" name="$(arg prefix)camera">
            <update_rate>30</update_rate>
            <visualize>true</visualize>
            
            <topic>$(arg prefix)camera/image_raw</topic> 
            
            <gz_frame_id>$(arg prefix)camera_link</gz_frame_id>
            
            <camera>
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>8.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>
</robot>
